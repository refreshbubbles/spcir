# URL pública do site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Prisma CLI (migrations)
DATABASE_URL="mysql://spcir:password@localhost:3306/spcir"

# Runtime (driver adapter MariaDB)
DATABASE_HOST="localhost"
DATABASE_PORT="3306"
DATABASE_USER="spcir"
DATABASE_PASSWORD="password"
DATABASE_NAME="spcir"

# Assistente virtual (Claude API). Sem chave, o widget mostra "assistente indisponível".
ANTHROPIC_API_KEY=""
# Opcional: modelo do assistente (por omissão claude-opus-5-5)
# CHAT_MODEL="claude-opus-5-5"
